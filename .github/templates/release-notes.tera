{%- macro group_intro(key) -%}
{%- if key == "Breaking Changes" -%}
Changes that require attention before upgrading.
{%- elif key == "Security" -%}
Security-related fixes and hardening.
{%- elif key == "Dependencies" -%}
Dependency updates and maintenance.
{%- elif key == "Features" -%}
New functionality and capabilities.
{%- elif key == "Bug Fixes" -%}
Corrections to unexpected or broken behaviour.
{%- elif key == "Performance" -%}
Speed, memory, and efficiency improvements.
{%- elif key == "Interface" -%}
Visual, styling, and user-experience updates.
{%- elif key == "Architecture" -%}
Internal structure and design changes.
{%- elif key == "Refactoring" -%}
Code cleanup with no intended behaviour change.
{%- elif key == "Build System" -%}
Packaging, build, and tooling changes.
{%- elif key == "Testing" -%}
Test coverage and test infrastructure changes.
{%- elif key == "Documentation" -%}
Documentation and project guidance updates.
{%- elif key == "Automation" -%}
Continuous integration and workflow changes.
{%- elif key == "Reverts" -%}
Changes that were rolled back.
{%- elif key == "Maintenance" -%}
Routine repository and project upkeep.
{%- else -%}
Changes that do not fit the categories above.
{%- endif -%}
{%- endmacro -%}

{%- set group_keys = [
    "Breaking Changes",
    "Security",
    "Dependencies",
    "Features",
    "Bug Fixes",
    "Performance",
    "Interface",
    "Architecture",
    "Refactoring",
    "Build System",
    "Testing",
    "Documentation",
    "Automation",
    "Reverts",
    "Maintenance",
    "Other Changes"
] -%}

{%- set_global total_additions = 0 -%}
{%- set_global total_deletions = 0 -%}
{%- set_global total_files = 0 -%}
{%- for commit in commits -%}
{%- set_global total_additions = total_additions + commit.statistics.additions -%}
{%- set_global total_deletions = total_deletions + commit.statistics.deletions -%}
{%- set_global total_files = total_files + commit.statistics.files_changed -%}
{%- endfor -%}

{%- set breaking_commits = commits | filter(attribute="breaking", value=true) -%}

