#!/usr/bin/env bash
# switch · fuzzy jump to any pane in any session (zbuffers replacement). Ctrl Space
# enter = jump   ctrl-x = close that pane
command -v fzf >/dev/null || { tmux choose-tree -Zw; exit; }
list() { tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}'$'\t''#{session_name} #{window_index}:#{window_name}'$'\t''#{pane_current_command}'$'\t''#{pane_current_path}'; }
sel=$(list | fzf --ansi --delimiter=$'\t' --with-nth=2.. --layout=reverse --border=none \
  --prompt=' ❯ ' --pointer='▌' --color='bg:#24273a,bg+:#363a4f,fg:#cad3f5,fg+:#cad3f5,hl:#f5a97f,hl+:#f5a97f,prompt:#c6a0f6,pointer:#c6a0f6,info:#6e738d,border:#c6a0f6' \
  --preview='tmux capture-pane -ep -t {1}' --preview-window=right,55% \
  --expect=ctrl-x) || exit 0
key=$(head -1 <<<"$sel"); target=$(sed -n 2p <<<"$sel" | cut -f1)
[ -z "$target" ] && exit 0
if [ "$key" = ctrl-x ]; then tmux kill-pane -t "$target"; exit 0; fi
tmux switch-client -t "${target%%:*}" \; select-window -t "${target%.*}" \; select-pane -t "$target"
