# ── CORE ───────────────────────────────────────────────────────────────────
set -g default-terminal "tmux-256color"
set -as terminal-features ",*:RGB"          # true color
set -as terminal-features ",*:usstyle"      # colored/curly underlines (nvim)
set -g escape-time 10                       # low, but keeps Alt keys reliable
set -g focus-events on                      # nvim autoread, etc.
set -g history-limit 50000
set -g base-index 1                         # tabs start at 1, like Zellij
set -g pane-base-index 1
set -g renumber-windows on
set -g mouse on
set -g mode-keys vi
set -g status-keys emacs
set -g set-clipboard on
set -g allow-passthrough on                 # image protocols, OSC 133 marks
set -g detach-on-destroy off
set -g aggressive-resize on
set -g monitor-bell on
set -g bell-action other
set -g visual-bell off
set -g copy-command "wl-copy"               # Wayland clipboard (Omarchy)
set -g repeat-time 0

# Every tab is named after its current directory (home shows as ~).
# Renaming a tab by hand (Ctrl t r) pins that name for that tab.
set -g @home "$HOME"
set -g allow-rename off
set -g automatic-rename on
set -g automatic-rename-format "#{?#{==:#{pane_current_path},#{@home}},~,#{b:pane_current_path}}"

# ── COLORS ─────────────────────────────────────────────────────────────────
# Border is deliberately subtle: the two dashes tmux always draws at each end of the
# bottom bar use this color. Raise to ${C_S2} / ${C_MAUVE} if you want louder frames.
set -g pane-border-style "fg=${C_S0},bg=${C_BASE}"
set -g pane-active-border-style "fg=${C_S2},bg=${C_BASE}"
set -g pane-border-lines single
set -g message-style "bg=${C_MAUVE},fg=${C_CRUST},bold"
set -g message-command-style "bg=${C_PEACH},fg=${C_CRUST},bold"
set -g mode-style "bg=${C_S1},fg=${C_PINK}"
set -g copy-mode-match-style "bg=${C_S1},fg=${C_YELLOW}"
set -g copy-mode-current-match-style "bg=${C_YELLOW},fg=${C_CRUST}"
set -g copy-mode-mark-style "bg=${C_PINK},fg=${C_CRUST}"
set -g menu-style "bg=${C_MANTLE},fg=${C_TEXT}"
set -g menu-selected-style "bg=${C_MAUVE},fg=${C_CRUST},bold"
set -g menu-border-style "fg=${C_MAUVE}"
set -g popup-style "bg=${C_BASE},fg=${C_TEXT}"
set -g popup-border-style "fg=${C_MAUVE}"
set -g popup-border-lines rounded
set -g display-panes-colour "${C_S2}"
set -g display-panes-active-colour "${C_MAUVE}"
set -g clock-mode-colour "${C_MAUVE}"
set -g window-status-activity-style "fg=${C_PEACH}"
set -g window-status-bell-style "fg=${C_RED}"

# ── TOP BAR · tabs | notifications | session ───────────────────────────────
set -g status on
set -g status-position top
set -g status-interval 5
set -g status-style "bg=${C_BASE},fg=${C_TEXT}"
# The #(...) at the end prints nothing; it is how tmux-continuum gets its autosave tick,
# because continuum normally hooks status-right, which this custom bar does not use.
set -g status-format[0] "#[align=left]#[fg=${C_TEXT}]#[bg=${C_BASE}] #{W:#[range=window|#{window_index}]#[fg=${C_S1}]#[bg=${C_BASE}]#[fg=${C_SUB0}]#[bg=${C_S1}]#[bold] #I #[fg=${C_S1}]#[bg=${C_S0}]#[fg=${C_SUB0}]#[bg=${C_S0}]#[nobold] #{=/18/…:window_name}#{?window_zoomed_flag, 󰊓,}#{?window_bell_flag, ,}#{?pane_synchronized,  ,} #[fg=${C_S0}]#[bg=${C_BASE}]#[norange]#[fg=${C_TEXT}]#[bg=${C_BASE}] ,#[range=window|#{window_index}]#[fg=${C_MAUVE}]#[bg=${C_BASE}]#[fg=${C_CRUST}]#[bg=${C_MAUVE}]#[bold] #I #[fg=${C_MAUVE}]#[bg=${C_S1}]#[fg=${C_TEXT}]#[bg=${C_S1}]#[bold] #{=/18/…:window_name}#{?window_zoomed_flag, 󰊓,}#{?window_bell_flag, ,}#{?pane_synchronized,  ,} #[fg=${C_S1}]#[bg=${C_BASE}]#[norange]#[fg=${C_TEXT}]#[bg=${C_BASE}] }#[align=centre]#{?#{@notify},#[fg=${C_YELLOW}]#[bg=${C_BASE}]#[fg=${C_CRUST}]#[bg=${C_YELLOW}]#[bold]  #[fg=${C_YELLOW}]#[bg=${C_S1}]#[nobold]#[fg=${C_TEXT}]#[bg=${C_S1}] #{@notify} #[fg=${C_S1}]#[bg=${C_BASE}],}#[align=right]#[fg=${C_SAPPHIRE}]#[bg=${C_BASE}]#[fg=${C_CRUST}]#[bg=${C_SAPPHIRE}]#[bold] 󰆍 #[fg=${C_SAPPHIRE}]#[bg=${C_S1}]#[nobold]#[fg=${C_TEXT}]#[bg=${C_S1}]#[bold] #S #[fg=${C_S1}]#[bg=${C_BASE}]#[nobold]#[fg=${C_TEXT}]#[bg=${C_BASE}] #(~/.config/tmux/plugins/tmux-continuum/scripts/continuum_save.sh)"
# notify script state (see script/notify). Empty text hides the pill.
set -g @notify ""
set -g @notify_gen "0"

