# `fill` paints the whole border row with the bar background; the border line
# stays visible between panes. Left part only on the bottom-left pane, right
# part only on the bottom-right pane, so split windows do not repeat the bar.
set -g pane-border-status bottom
set -g pane-border-format "#[fill=${C_BASE}]#{?#{&&:#{pane_at_bottom},#{pane_at_left}},#[align=left]#[fg=${C_TEXT}]#[bg=${C_BASE}] #{?#{==:#{client_key_table},off},#{E:@bar_off},#{?#{==:#{client_key_table},prefix},#{E:@bar_prefix},#{?#{==:#{client_key_table},session},#{E:@bar_session},#{?#{==:#{client_key_table},move},#{E:@bar_move},#{?#{==:#{client_key_table},resize},#{E:@bar_resize},#{?#{==:#{client_key_table},tab},#{E:@bar_tab},#{?#{==:#{client_key_table},pane},#{E:@bar_pane},#{?pane_in_mode,#{E:@bar_scroll},#{E:@bar_root}}}}}}}}},}#{?#{&&:#{pane_at_bottom},#{pane_at_right}},#[align=right]#{E:@bar_strip}#[default] ,}"

# ═════════════════════════════ KEYBINDS ════════════════════════════════════
# tmux has no mode inheritance, so the 'global' keys are repeated in every
# table. Modes stay active after a key like Zellij does (the generator adds
# `switch-client -T <mode>` after each bind that should keep the mode).
unbind -a -T prefix                   # prefix table becomes the TMUX mode
set -g prefix C-b

# ── GLOBAL KEYS (every mode except LOCKED) ─────────────────────────────────
# Alt n new pane · Alt f float · Alt h/j/k/l focus · Alt i/o move tab
# Alt [ ] layouts · Alt + - resize · Alt p mark pane · Alt Shift p join marked
# Alt x extract · Alt y urls · Alt v files · Ctrl Space switcher
# · table: root
bind -n 'M-n' if -F "#{e|>:#{pane_width},#{e|*:#{pane_height},2}}" { split-window -h -c "#{pane_current_path}" } { split-window -v -c "#{pane_current_path}" }
bind -n 'M-f' if -F "#{m:float_*,#{session_name}}" { detach-client } { display-popup -E -w 85% -h 80% -b rounded -S "fg=${C_MAUVE}" -s "bg=${C_BASE}" -T "#[fg=${C_MAUVE}] float " -d "#{pane_current_path}" "bash ~/.config/tmux/script/float '#{session_name}' '#{pane_current_path}'" }
bind -n 'M-j' select-pane -D
bind -n 'M-k' select-pane -U
bind -n 'M-Left' if -F "#{pane_at_left}" { previous-window } { select-pane -L }
bind -n 'M-Right' if -F "#{pane_at_right}" { next-window } { select-pane -R }
