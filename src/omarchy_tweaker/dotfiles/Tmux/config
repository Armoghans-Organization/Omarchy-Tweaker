# ── NOTIFICATIONS · feeds the top-bar center ───────────────────────────────
# A bell in any background tab pops up a pill for 5 seconds.
set-hook -g alert-bell "run-shell -b 'bash ~/.config/tmux/script/notify -l warn \"Bell in #{window_index}:#{window_name}\"'"
# Manual use from a shell:   notify -l ok "build finished"
# Long-command alert for zsh: see the snippet at the top of script/notify.

# ═════════════════════════════ PLUGINS · TPM ═══════════════════════════════
# Plugins live in ~/.config/tmux/plugins. Install them with  Ctrl b  then  I
# (capital i). Update with  Ctrl b U.  Remove: delete the line, then  Ctrl b M-u.
# If TPM is missing it is cloned automatically the first time tmux starts
# (needs git + internet).
set-environment -g TMUX_PLUGIN_MANAGER_PATH "~/.config/tmux/plugins/"

set -g @plugin "tmux-plugins/tpm"

# Saves/restores sessions, windows, panes and their folders. Ctrl b then Ctrl s / Ctrl r
# are resurrect's own keys; they only work in the TMUX mode (Ctrl b).
set -g @plugin "tmux-plugins/tmux-resurrect"
set -g @resurrect-capture-pane-contents "on"
set -g @resurrect-strategy-nvim "session"

# Autosaves every 10 minutes and restores everything when tmux starts.
set -g @plugin "tmux-plugins/tmux-continuum"
set -g @continuum-restore "on"
set -g @continuum-save-interval "10"

# More you can enable (uncomment, then Ctrl b I):
# set -g @plugin "tmux-plugins/tmux-open"          # o opens the selection in copy mode
# set -g @plugin "fcsonline/tmux-thumbs"           # hint-based copy, like vimium for the pane
# set -g @plugin "sainnhe/tmux-fzf"                # fzf menus for sessions, windows, panes
# set -g @plugin "omerxx/tmux-sessionx"            # fuzzy session manager

# Auto-install TPM on first run
if "test ! -d ~/.config/tmux/plugins/tpm" \
   "run 'git clone https://github.com/tmux-plugins/tpm ~/.config/tmux/plugins/tpm && ~/.config/tmux/plugins/tpm/bin/install_plugins'"

# Keep this line at the very bottom
run "~/.config/tmux/plugins/tpm/tpm"
