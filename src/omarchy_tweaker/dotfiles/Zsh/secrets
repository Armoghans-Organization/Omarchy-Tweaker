# ========================================================
#  Private environment — sourced last by .zshrc
#  File permissions are set to 600: only the owner can read it.
#  Fill in the values below, then open a new shell.
# ========================================================

# -- OpenRouter (gateway used by Omniroute / AI tools) ----
# API key:     https://openrouter.ai/keys
# Management key: https://openrouter.ai/account
export OPENROUTER_API_KEY="{openrouter_api_key}"
export OPENROUTER_MANAGEMENT_KEY="{openrouter_management_key}"

# -- Omniroute (AI tools) ---------------------------------
# API key:     http://omniroute.localhost/dashboard/api-manager
# Management key: http://omniroute.localhost/dashboard/api-manager
export OMNIROUTE_API_KEY="{omniroute_api_key}"
export OMNIROUTE_MANAGEMENT_KEY="{omniroute_management_key}"

# -- Omniroute per-tool API keys --------------------------
# Same Omniroute Key can be used for multiple tools,
# but you can also use different keys for each tool if you want to track usage separately.
export OMNIROUTE_CLAUDE_API_KEY="{omniroute_claude_api_key}"
export OMNIROUTE_OPENCODE_API_KEY="{omniroute_opencode_api_key}"
export OMNIROUTE_ATUIN_API_KEY="{omniroute_atuin_api_key}"

# -- Other secrets ------------------------------------------
#  Add any other secrets you want to keep private here,
#  such as API keys, passwords, or tokens.
# ie: AWS keys, database passwords, etc.

# export Other_secret="<your_secret_here>"
