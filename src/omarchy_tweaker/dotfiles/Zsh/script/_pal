#!/usr/bin/env bash
# ╭────────────────────────────────────────────────────────────────────────╮
# │  pal · command palette · Catppuccin Macchiato                          │
# │  Put at: ~/.local/bin/_pal  (alias: pal)                               │
# │  Same look and keys as lzj, tij and server.                            │
# ╰────────────────────────────────────────────────────────────────────────╯
#
#  Shows every zsh key binding (from `bindkey`) and every tmux key (from
#  `tmux list-keys`), with icons, descriptions and a preview, and RUNS the one
#  you pick.
#
#  pal                 browse the palette (zsh keys are shown, tmux keys can be run)
#  pal ls [MODE]       plain list for scripts      MODE: all custom zsh tmux everything
#  bindkey -L | pal --import      hand pal your zsh keys by hand
#  pal -h | -v
#
#  The bundled Zsh config defines command-pallet-widget on Alt+Shift+P.
#  That widget hands pal your LIVE `bindkey` table and then runs the widget you
#  pick, exactly as if you had pressed its key. A program outside the shell
#  cannot do that, which is why the widget is needed.
#
#  Needs:    fzf, python3 (decodes keys and builds the list)
#  Used when present (all optional):
#            gum   toasts     bat   the definition of a widget in your zsh files
#            eza   folder tree for file widgets     wl-copy / xclip   copy a key
#
#  Your own descriptions: ~/.config/pal/descriptions, one per line:
#       lazygit-widget = Open lazygit in this repo

set -uo pipefail

VERSION="1.0.0"

FZF_BIN="${FZF_BIN:-$(command -v fzf || true)}"
GUM_BIN="${GUM_BIN:-$(command -v gum || true)}"
BAT_BIN="${BAT_BIN:-$(command -v bat || true)}"
EZA_BIN="${EZA_BIN:-$(command -v eza || true)}"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pal"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pal"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/pal/bindkey.txt"

# ── Colors (Catppuccin Macchiato) ──────────────────────────────────────────
RST=$'\033[0m'; BOLD=$'\033[1m'; ITAL=$'\033[3m'
fgc() { printf '\033[38;2;%d;%d;%dm' "$1" "$2" "$3"; }
bgc() { printf '\033[48;2;%d;%d;%dm' "$1" "$2" "$3"; }
MAUVE="$(fgc 198 160 246)"; TEAL="$(fgc 139 213 202)"; GREEN="$(fgc 166 218 149)"
RED="$(fgc 237 135 150)";   YELLOW="$(fgc 238 212 159)"; PEACH="$(fgc 245 169 127)"
BLUE="$(fgc 138 173 244)";  TEXT="$(fgc 202 211 245)";   PINK="$(fgc 245 189 230)"
SUB="$(fgc 165 173 203)";   DIM="$(fgc 110 115 141)";    LINE="$(fgc 73 77 100)"
CRUST="$(fgc 24 25 38)"
BG_MAUVE="$(bgc 198 160 246)"; BG_GREEN="$(bgc 166 218 149)"; BG_BLUE="$(bgc 138 173 244)"
BG_PEACH="$(bgc 245 169 127)"; BG_TEAL="$(bgc 139 213 202)"; BG_SUB="$(bgc 165 173 203)"

# Glyphs are built from codepoints (UTF-8 bytes) so no editor or locale can strip them.
u8() {
    local cp=$((16#$1)) b1 b2 b3 b4
    if (( cp < 0x800 )); then
        b1=$(( 0xC0 | (cp >> 6) )); b2=$(( 0x80 | (cp & 0x3F) )); printf '\\x%02x\\x%02x' "$b1" "$b2"
    elif (( cp < 0x10000 )); then
        b1=$(( 0xE0 | (cp >> 12) )); b2=$(( 0x80 | ((cp >> 6) & 0x3F) )); b3=$(( 0x80 | (cp & 0x3F) ))
        printf '\\x%02x\\x%02x\\x%02x' "$b1" "$b2" "$b3"
    else
        b1=$(( 0xF0 | (cp >> 18) )); b2=$(( 0x80 | ((cp >> 12) & 0x3F) )); b3=$(( 0x80 | ((cp >> 6) & 0x3F) )); b4=$(( 0x80 | (cp & 0x3F) ))
        printf '\\x%02x\\x%02x\\x%02x\\x%02x' "$b1" "$b2" "$b3" "$b4"
    fi
}
g() { printf "$(u8 "$1")"; }
I_KEY="$(g f11c)"; I_WARN="$(g f071)"; I_CHECK="$(g f00c)"; I_BOLT="$(g f0e7)"; I_HELP="$(g f059)"
I_TERM="$(g f120)"; I_COPY="$(g f0c5)"; I_EYE="$(g f06e)"; I_FILE="$(g f15c)"; I_DIR="$(g f07b)"
I_STAR="$(g f005)"; I_TOOL="$(g f0ad)"; I_PEN="$(g f040)"; I_EDIT="$(g f044)"
CAP_L="$(g e0b6)"; CAP_R="$(g e0b4)"

# ── The Python part: decodes keys, builds the rows ─────────────────────────
PAL_PY=$(cat <<'PYEOF'
import os, re, sys, signal
signal.signal(signal.SIGPIPE, signal.SIG_DFL)      # `pal ls | head` must not print a traceback

# usage: rows MODE            -> fzf rows (tab separated, last field is the colored display)
#        keysof WIDGET        -> key pills of every key bound to the widget
#        decode RAWKEY        -> readable key text
mode = sys.argv[1] if len(sys.argv) > 1 else "all"
TABLE = None
if mode == "table":                     # table MODE STYLE WIDTH  (STYLE: pretty | plain)
    TABLE = (sys.argv[3] if len(sys.argv) > 3 else "pretty", int(sys.argv[4]) if len(sys.argv) > 4 else 100)
    mode = sys.argv[2] if len(sys.argv) > 2 else "zsh"

# ── colors (Catppuccin Macchiato) ──────────────────────────────────────────
def fg(r, g, b): return "\033[38;2;%d;%d;%dm" % (r, g, b)
def bg(r, g, b): return "\033[48;2;%d;%d;%dm" % (r, g, b)
RST = "\033[0m"; BOLD = "\033[1m"
MAUVE = fg(198, 160, 246); TEAL = fg(139, 213, 202); GREEN = fg(166, 218, 149); RED = fg(237, 135, 150)
YELLOW = fg(238, 212, 159); PEACH = fg(245, 169, 127); BLUE = fg(138, 173, 244); PINK = fg(245, 189, 230)
TEXT = fg(202, 211, 245); SUB = fg(165, 173, 203); DIM = fg(110, 115, 141)
LINE = fg(73, 77, 100)
SURF = (54, 58, 79)                                   # surface0, the keycap color
CAP_L = chr(0xE0B6); CAP_R = chr(0xE0B4)

def keycap(text):
    return fg(*SURF) + CAP_L + RST + bg(*SURF) + TEXT + BOLD + " " + text + " " + RST + fg(*SURF) + CAP_R + RST

def keycap_width(text): return len(text) + 4

# category: (icon codepoint, color, label)
CATS = {
    "t": (0xF0AD, MAUVE,  "tools"),
    "h": (0xF1DA, PEACH,  "history"),
    "e": (0xF040, BLUE,   "editing"),
    "c": (0xF0D0, TEAL,   "completion"),
    "s": (0xF013, SUB,    "shell"),
    "x": (0xF120, GREEN,  "tmux"),
}
CAT_ORDER = ["t", "h", "e", "c", "s", "x"]

# widget | category | description
ZSH_TABLE = """
