layout {
    pane
    pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {

                // ── Catppuccin Macchiato ─────────────────────────────
                color_rosewater "#f4dbd6"
                color_flamingo  "#f0c6c6"
                color_pink      "#f5bde6"
                color_mauve     "#c6a0f6"
                color_red       "#ed8796"
                color_maroon    "#ee99a0"
                color_peach     "#f5a97f"
                color_yellow    "#eed49f"
                color_green     "#a6da95"
                color_teal      "#8bd5ca"
                color_sky       "#91d7e3"
                color_sapphire  "#7dc4e4"
                color_blue      "#8aadf4"
                color_lavender  "#b7bdf8"
                color_text      "#cad3f5"
                color_subtext1  "#b8c0e0"
                color_subtext0  "#a5adcb"
                color_overlay2  "#939ab7"
                color_overlay1  "#8087a2"
                color_overlay0  "#6e738d"
                color_surface2  "#5b6078"
                color_surface1  "#494d64"
                color_surface0  "#363a4f"
                color_base      "#24273a"
                color_mantle    "#1e2030"
                color_crust     "#181926"

                // ── Layout: tabs | notifications | session ───────────
                format_left   "#[bg=$base] {tabs}"
                format_center "{notifications}"
                format_right  "#[bg=$base,fg=$sapphire]#[bg=$sapphire,fg=$crust,bold] 󰆍 #[bg=$surface1,fg=$sapphire]#[bg=$surface1,fg=$text,bold] {session} #[bg=$base,fg=$surface1]#[bg=$base] "
                // format_right "#[bg=$base,fg=$mauve]#[bg=$mauve,fg=$crust,bold] #[bg=$surface1,fg=$mauve]#[bg=$surface1,fg=$text,bold] {session} #[bg=$base,fg=$surface1]"
                format_space  "#[bg=$base]"
                format_hide_on_overlength "true"
                format_precedence "lrc"

                hide_frame_for_single_pane "false"

                // ── Tabs ─────────────────────────────────────────────
                tab_normal              "#[bg=$base,fg=$surface1]#[bg=$surface1,fg=$subtext0,bold] {index} #[bg=$surface0,fg=$surface1]#[bg=$surface0,fg=$subtext0,nobold] {name}{floating_indicator} #[bg=$base,fg=$surface0]"
                tab_normal_fullscreen   "#[bg=$base,fg=$surface1]#[bg=$surface1,fg=$subtext0,bold] {index} #[bg=$surface0,fg=$surface1]#[bg=$surface0,fg=$subtext0,nobold] {name}{fullscreen_indicator} #[bg=$base,fg=$surface0]"
                tab_normal_sync         "#[bg=$base,fg=$surface1]#[bg=$surface1,fg=$subtext0,bold] {index} #[bg=$surface0,fg=$surface1]#[bg=$surface0,fg=$subtext0,nobold] {name}{sync_indicator} #[bg=$base,fg=$surface0]"
                tab_active              "#[bg=$base,fg=$mauve]#[bg=$mauve,fg=$crust,bold] {index} #[bg=$surface1,fg=$mauve]#[bg=$surface1,fg=$text,bold] {name}{floating_indicator} #[bg=$base,fg=$surface1]"
                tab_active_fullscreen   "#[bg=$base,fg=$mauve]#[bg=$mauve,fg=$crust,bold] {index} #[bg=$surface1,fg=$mauve]#[bg=$surface1,fg=$text,bold] {name}{fullscreen_indicator} #[bg=$base,fg=$surface1]"
                tab_active_sync         "#[bg=$base,fg=$mauve]#[bg=$mauve,fg=$crust,bold] {index} #[bg=$surface1,fg=$mauve]#[bg=$surface1,fg=$text,bold] {name}{sync_indicator} #[bg=$base,fg=$surface1]"
                tab_separator           "#[bg=$base] "

                tab_sync_indicator       " "
                tab_fullscreen_indicator " 󰊓"
                tab_floating_indicator   " 󰹙"

                // ── Notifications ────────────────────────────────────
                notification_format_unread           "#[bg=$base,fg=$yellow]#[bg=$yellow,fg=$crust,bold]  #[bg=$surface1,fg=$yellow]#[bg=$surface1,fg=$text] {message} #[bg=$base,fg=$surface1]"
                notification_format_no_notifications ""
                notification_show_interval           "10"
            }
        }
}
