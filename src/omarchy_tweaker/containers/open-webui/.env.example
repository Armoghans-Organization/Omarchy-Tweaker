# ==========================================
# Open WebUI Configuration
# ==========================================

# WebUI listening port
PORT=6901

# Generate using: openssl rand -hex 32
WEBUI_SECRET_KEY=replace_with_random_secret

# UI easter eggs
ENABLE_EASTER_EGGS=true

# Trusted reverse proxy IPs
FORWARDED_ALLOW_IPS=127.0.0.1

# Ollama API
OLLAMA_BASE_URL=http://ollama.localhost

# OmniRoute API
OMNIROUTE_URL=http://omniroute.localhost
