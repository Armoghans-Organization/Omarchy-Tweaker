# ──────────────────────────────────────────────────────────────────────
#  SnapOtter — self-hosted file-processing suite
# ──────────────────────────────────────────────────────────────────────
#  Reference: https://docs.snapotter.com/guide/deployment.html
#
#  Omarchy Tweaker maps the container's internal port 1349 to host port
#  6906 and publishes it on 127.0.0.1 only. Caddy exposes
#  http://snapotter.localhost.

# ── Web UI / API (host-side) ──────────────────────────────────────────
# Loopback port Caddy proxies to. Keep in sync with docker-compose.yml.
PORT=6906

# ── SnapOtter application ─────────────────────────────────────────────
# Internal container port. Do not change unless the image changes it.
SNAPOTTER_INTERNAL_PORT=1349

# First-login credentials. Change DEFAULT_USERNAME/DEFAULT_PASSWORD after
# the first login; SnapOtter forces a password change on first login.
SNAPOTTER_USERNAME=admin
SNAPOTTER_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=snapotter
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=snapotter
