# Global host-level reverse proxy routes for the local development setup.
# Not part of any container.

# Main Omarchy site
http://omarchy.localhost {
    encode zstd gzip

    reverse_proxy 127.0.0.1:80

    log {
        output file /var/log/caddy/omarchy.log {
            roll_size 10MiB
            roll_keep 3
            roll_keep_for 7d
        }
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}

# Hugo development server
http://hugo.localhost {
    encode zstd gzip

    reverse_proxy 127.0.0.1:1313

    log {
        output file /var/log/caddy/hugo.log {
            roll_size 10MiB
            roll_keep 3
            roll_keep_for 7d
        }
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}

